# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Supabase (get from https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PikaSim eSIM API (server-side only — NEVER prefix with NEXT_PUBLIC_)
PIKASIM_API_KEY=pk_live_your_key_here

# Crypto wallet addresses (your receiving wallets)
MONERO_WALLET_PRIMARY=your_primary_monero_address
MONERO_WALLET_BACKUP_1=your_backup_monero_address_1
MONERO_WALLET_BACKUP_2=your_backup_monero_address_2
ETHEREUM_WALLET_ADDRESS=your_ethereum_wallet_address

# JWT signing secret (generate: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_minimum_64_chars_here

# Encryption key for sensitive DB fields (generate: openssl rand -hex 32)
DB_ENCRYPTION_KEY=your_32_byte_hex_key_here

# Webhook secrets (generate random strings)
MONERO_WEBHOOK_SECRET=your_monero_webhook_secret
ETHEREUM_WEBHOOK_SECRET=your_ethereum_webhook_secret

# Crypto price API (optional, uses CoinGecko free tier by default)
COINGECKO_API_KEY=

# App URL (for webhook callbacks)
NEXT_PUBLIC_APP_URL=https://privasim.com

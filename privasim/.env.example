# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# PikaSim eSIM API (server-side only — NEVER prefix with NEXT_PUBLIC_)
PIKASIM_API_KEY=pk_live_your_key_here

# Crypto wallet addresses (your receiving wallets)
MONERO_WALLET_PRIMARY=your_primary_monero_address
ETHEREUM_WALLET_ADDRESS=your_ethereum_wallet_address

# JWT signing secret (generate: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_minimum_64_chars_here

# Encryption key for invoice data (generate: openssl rand -hex 32)
DB_ENCRYPTION_KEY=your_32_byte_hex_key_here

# Webhook secrets for payment notifications (generate: openssl rand -hex 16)
MONERO_WEBHOOK_SECRET=your_monero_webhook_secret
ETHEREUM_WEBHOOK_SECRET=your_ethereum_webhook_secret

# App URL
NEXT_PUBLIC_APP_URL=https://privasim.com

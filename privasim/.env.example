# Copy to .env.local and populate in your secret manager/deployment environment.
# Never commit .env.local or reuse these values in production.

# Managed PostgreSQL (TLS; deploy db/migrations/0001_enterprise.sql first)
DATABASE_URL=postgresql://user:password@host:5432/privasim?sslmode=require
DB_POOL_MAX=1

# Server-only supplier credentials
PIKASIM_API_KEY=replace-with-provider-key
PIKASIM_WEBHOOK_SECRET=replace-with-32+-random-bytes-if-provider-webhooks-are-enabled

# Optional supplier endpoint overrides (self-hosted proxy, regional mirror, mock)
# PIKASIM_REST_BASE=https://pikasim.com/api
# PIKASIM_MCP_BASE=https://pikasim.com/mcp

# Server-only wallet/RPC configuration
MONERO_WALLET_PRIMARY=83JkvCKVybdWSFJPrT7wKdQMosgdAnR97YG9GVNdKdk3bG6Aa6EjXMD4AGb6ngyTX2M3USfG46ieyck3HvFwSoa31f2vDfr
MONERO_WALLET_RPC_URL=https://wallet-rpc.example.com:18083
MONERO_WALLET_RPC_USER=replace-me
MONERO_WALLET_RPC_PASSWORD=replace-me
MONERO_ACCOUNT_INDEX=0
# Keep primary address/RPC wallet/account index aligned; keep old wallet online while open invoices settle.
ETHEREUM_WALLET_ADDRESS=0xYourReceivingWalletAddress
ETHEREUM_RPC_URL=https://your-authenticated-ethereum-mainnet-rpc.example

# Generate each key independently with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes
DB_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes-as-64-hex-characters
PAYMENT_HASH_SECRET=replace-with-at-least-32-random-bytes
COUPON_SIGNING_SECRET=replace-with-at-least-32-random-bytes
ADMIN_API_KEY=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-at-least-32-random-bytes

# Webhook HMAC secrets; coordinate the exact raw-body signature contract with each provider.
MONERO_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
ETHEREUM_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

# ── Exchange-rate feed (lib/priceFeed.ts) ────────────────────────────────────
# Resolution order: CoinGecko -> Kraken -> Binance -> last-known-good (PostgreSQL)
# -> FALLBACK_*_USD. Only set the overrides below if you need them.
# COINGECKO_API_KEY=
# PRICE_COINGECKO_BASE=https://api.coingecko.com/api/v3
# PRICE_KRAKEN_BASE=https://api.kraken.com/0/public
# PRICE_BINANCE_BASE=https://api.binance.com/api/v3
# How long a quote is reused before refreshing (default 300000 = 5 min)
# PRICE_FRESH_MS=300000
# How old a cached quote may get before it is refused (default 21600000 = 6 h)
# PRICE_MAX_STALE_MS=21600000
# Last-resort static rates. ONLY set these if you accept the risk of quoting a
# price that is not live; every quote served from them is logged as stale.
# FALLBACK_XMR_USD=
# FALLBACK_ETH_USD=

# Optional provider/API configuration
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SUPPORT_EMAIL=operator-support@example.com
NEXT_PUBLIC_APP_URL=https://privasim.app
